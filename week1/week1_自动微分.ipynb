   "source": [
    "import torch\n",
    "\n",
    "x = torch.ones(2,2,requires_grad=True)\n",
    "y = x+2\n",
    "z = y*y*3\n",
    "out = z.mean()\n",
    "out.backward()\n",
    "print(x.grad)"
   ]
